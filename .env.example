# Database
DB_NAME=time_tracker
DB_USER=postgres
DB_PASSWORD=change_me
DB_PORT=5432

# Server
SERVER_PORT=9000
ACCESS_TOKEN_SECRET=change_me_access
REFRESH_TOKEN_SECRET=change_me_refresh
ALLOWED_ORIGINS=http://localhost:3000,http://localhost

# Client build (docker-compose.yml / GitHub Actions Variables)
# Same-origin: browser hits one URL; nginx proxies /api → server
VITE_APP_URL=http://localhost:3000
VITE_API_ENDPOINT=http://localhost:3000

# Production (docker-compose.prod.yml)
# GHCR_IMAGE_PREFIX=ghcr.io/alexandrv9/time-tracker
# IMAGE_TAG=latest
# CLIENT_PORT=3000
# ALLOWED_ORIGINS=https://app.example.com
# VITE_APP_URL=https://app.example.com        # GitHub Actions Variable
# VITE_API_ENDPOINT=https://app.example.com   # GitHub Actions Variable

# Yandex OAuth (register at oauth.yandex.ru)
YANDEX_CLIENT_ID=change_me_yandex_client_id
YANDEX_CLIENT_SECRET=change_me_yandex_client_secret
# Dev (docker/nginx): http://localhost:3000/api/auth/yandex/callback
# Dev (vite direct): http://localhost:9000/auth/yandex/callback
YANDEX_REDIRECT_URI=http://localhost:3000/api/auth/yandex/callback
# URL браузер-side (куда делать редиректы после OAuth)
# Dev vite: http://localhost:5173, Dev docker: http://localhost:3000
CLIENT_URL=http://localhost:3000

# Email verification (EMAIL_TRANSPORT=console logs codes to server stdout)
EMAIL_TRANSPORT=console
EMAIL_FROM=noreply@example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURE=false
# EMAIL_CODE_TTL_SEC=600
# EMAIL_CODE_MAX_ATTEMPTS=5
# EMAIL_CODE_RESEND_COOLDOWN_SEC=60

# pgadmin (optional: docker compose --profile tools up)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change_me
