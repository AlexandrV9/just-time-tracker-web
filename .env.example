# Database
DB_NAME=time_tracker
DB_USER=postgres
DB_PASSWORD=change_me
DB_PORT=5432

# Server
SERVER_PORT=9000
ACCESS_TOKEN_SECRET=change_me_access
REFRESH_TOKEN_SECRET=change_me_refresh
ALLOWED_ORIGINS=http://localhost:3000,http://localhost

# Client build (docker-compose.yml / GitHub Actions Variables)
# Same-origin: browser hits one URL; nginx proxies /api → server
VITE_APP_URL=http://localhost:3000
VITE_API_ENDPOINT=http://localhost:3000

# Production (docker-compose.prod.yml)
# GHCR_IMAGE_PREFIX=ghcr.io/alexandrv9/time-tracker
# IMAGE_TAG=latest
# CLIENT_PORT=80
# ALLOWED_ORIGINS=https://app.example.com
# VITE_APP_URL=https://app.example.com        # GitHub Actions Variable
# VITE_API_ENDPOINT=https://app.example.com   # GitHub Actions Variable

# pgadmin (optional: docker compose --profile tools up)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change_me
