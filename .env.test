# Vitest overrides (loaded last in tests/setup/vitest.setup.ts).
# Tests run in ephemeral Docker Postgres — dev DB is never touched.

USE_TESTCONTAINERS=true
DEV_DB_PROTECT=time_tracker
TEST_DB_NAME=time_tracker_test

# Secrets for server config imports in tests
ACCESS_TOKEN_SECRET=change_me_access
REFRESH_TOKEN_SECRET=change_me_refresh
ALLOWED_ORIGINS=http://localhost:3000
