    "dotenv": "^17.2.2",
    "hono": "^4.9.7",
    "nodemailer": "^8.0.10",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^11.14.0",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^20.11.17",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.15.5",
    "testcontainers": "^11.14.0",
