{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "strict": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "outDir": "./dist",
    "erasableSyntaxOnly": true,
    "baseUrl": ".",
  },
  "exclude": ["node_modules", "src/**/*.test.ts", "vitest.config.ts"]
}