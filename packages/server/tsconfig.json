{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "strict": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "outDir": "./dist",
    "erasableSyntaxOnly": true,
    "paths": {
      "*": ["./src/*"]
    },
  },
  "exclude": [
    "node_modules",
    "src/**/*.test.ts",
    "tests/**/*.test.ts",
    "vitest.config.ts"
  ]
}