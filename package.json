{
  "name": "to-do-list",
  "version": "1.0.5",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev:client": "pnpm --filter @to-do-list/client dev",
    "dev:server": "pnpm --filter @to-do-list/server dev",
    "dev:shared": "pnpm --filter @to-do-list/shared dev",
    "dev": "concurrently \"pnpm run dev:server\" \"pnpm run dev:client\" \"pnpm run dev:shared\"",
    "build:shared": "pnpm --filter @to-do-list/shared build",
    "build:client": "pnpm --filter @to-do-list/client build",
    "build:server": "pnpm --filter @to-do-list/server build",
    "build": "concurrently \"pnpm run build:shared\" \"pnpm run build:client\" \"pnpm run build:server\"",
    "lint": "pnpm --filter @to-do-list/client eslint",
    "test": "pnpm --filter @to-do-list/server test",
    "verify": "pnpm lint && pnpm build:shared && pnpm test && pnpm build",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.26.2",
  "devDependencies": {
    "concurrently": "^9.2.1",
    "husky": "^9.1.7"
  }
}
