{
  "name": "to-do-list",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev:client": "pnpm --filter @to-do-list/client dev",
    "dev:server": "pnpm --filter @to-do-list/server dev",
    "dev:shared": "pnpm --filter @to-do-list/shared dev",
    "dev": "concurrently \"pnpm run dev:server\" \"pnpm run dev:client\" \"pnpm run dev:shared\"",
    "build:shared": "pnpm --filter @to-do-list/shared build",
    "build": "concurrently \"pnpm run build:shared\" \"pnpm run build --workspace=client\" \"pnpm run build --workspace=server\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.14.0",
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
